def get_wars_after_quality_filtered(wildcards, filepath_prepend, filepath_append):
    """Paths under filepath_prepend for every animal war_quality_filter kept."""
    return [
        str(Path(filepath_prepend) / anim / filepath_append)
        for anim in ANIMALS
        if _passed_quality_filter(anim)
    ]

def get_all_flattened_manual_wars(wildcards):
    """Get all manually channel-filtered flattened WAR paths"""
    return get_wars_after_quality_filtered(wildcards, "results/wars_flattened_manual", "war.parquet")


def get_all_flattened_lof_wars(wildcards):
    """Get all LOF channel-filtered flattened WAR paths"""
    return get_wars_after_quality_filtered(wildcards, "results/wars_flattened_lof", "war.parquet")


def get_diagnostic_figures_unfiltered(wildcards):
    return get_wars_after_quality_filtered(wildcards, "results/diagnostic_figures", "unfiltered")

def get_diagnostic_figures_filtered(wildcards):
    return get_wars_after_quality_filtered(wildcards, "results/diagnostic_figures", "filtered")



