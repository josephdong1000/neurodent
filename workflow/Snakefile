"""
NeuRodent Snakemake Pipeline
========================

This pipeline processes raw EEG data through multiple analysis stages:
1. Raw files → WARs (Windowed Analysis Results)
2. WARs → Temporal heatmaps (animal-level diagnostics)
3. WARs → Diagnostic figures
4. WARs → Flattened WARs → Final EP figures
"""

from pathlib import Path
import pandas as pd
import json
import re
import os
import sys
import glob

# Import workflow utilities
from neurodent.workflow.utils import deep_merge_dict, merge_dataset_config, expand_animals_config, format_config_value, increment_memory, load_samples_config, resolve_samples_config
from neurodent.workflow.utils import format_exclusion_summary, quality_filter_outcome
from snakemake.logging import logger


# Load configuration
configfile: "config/config.yaml"

# Load local override if it exists (skip if file is empty/comment-only)
if os.path.exists("config/config.local.yaml"):
    import yaml as _yaml
    with open("config/config.local.yaml") as _f:
        _local_config = _yaml.safe_load(_f)
    if isinstance(_local_config, dict):
        configfile: "config/config.local.yaml"


# Apply dataset-specific configuration
active_dataset = os.environ.get("NEURODENT_DATASET", config.get("active_dataset", "sox5_bin"))
dataset_config_file = f"config/datasets/{active_dataset}.yaml"

if os.path.exists(dataset_config_file):
    # Deep-merge the dataset config into the main config. Shared with standalone
    # tools via merge_dataset_config so they never drift on how datasets apply.
    config, dataset_config = merge_dataset_config(config, active_dataset)

    print(f"[ok] Using dataset: {active_dataset}")
    print(f"  Config file: {dataset_config_file}")
    print(f"\n  Dataset configuration overrides:")
    print(format_config_value(dataset_config, indent=4))
    print()
else:
    # List available datasets by scanning config/datasets/ directory
    available_datasets = []
    if os.path.exists("config/datasets"):
        available_datasets = [f.replace('.yaml', '') for f in os.listdir("config/datasets") if f.endswith('.yaml')]

    raise FileNotFoundError(
        f"Dataset config file not found: {dataset_config_file}\n"
        f"Available datasets: {', '.join(available_datasets) if available_datasets else 'None'}"
    )

# Configuration validation (run after dataset config is merged)
from snakemake.utils import validate
validate(config, schema="schemas/config.schema.yaml")


# Load sample definitions
from datetime import datetime
from neurodent.core.utils import slugify

# Verify snakemake is installed before importing from it
try:
    from snakemake.io import glob_wildcards
except ImportError:
    raise ImportError(
        "Snakemake is required for pipeline functionality.\n"
        "Install with either:\n"
        "  pip install neurodent[pipeline]\n"
        "  uv pip install neurodent[pipeline]\n"
    )

# Load samples config: inline 'samples_data' block or 'samples.samples_file' (.json/.yaml)
samples_config = resolve_samples_config(config)

# Expand unified "animals" list into pipeline keys (if present)
samples_config = expand_animals_config(samples_config)

# Extract sample information from the unified "animals" list
ANIMALS = []
ANIMAL_TO_FOLDERS_MAP = {}  # Maps slugified animal_id -> list of (folder, animal_id, original_session_key)
ANIMAL_TO_FULL_ID_MAP = {} # Maps slugified animal_id -> original animal_id string

if "animals" in samples_config:
    # Unified format: iterate directly from animals list
    for animal_entry in samples_config["animals"]:
        animal = animal_entry["id"]
        slugified_name = slugify(animal, allow_unicode=True)

        if slugified_name not in ANIMALS:
            ANIMALS.append(slugified_name)
            ANIMAL_TO_FOLDERS_MAP[slugified_name] = []
            ANIMAL_TO_FULL_ID_MAP[slugified_name] = animal

        # Each animal gets a single entry; pattern handles discovery
        ANIMAL_TO_FOLDERS_MAP[slugified_name].append(("", animal, ""))
else:
    raise KeyError("Samples config must contain an 'animals' list")

# Optionally limit to first N animals (useful for testing)
_truncate_animals = config.get("samples", {}).get("truncate_animals", None)
if _truncate_animals is not None:
    ANIMALS = ANIMALS[:_truncate_animals]
    ANIMAL_TO_FOLDERS_MAP = {k: v for k, v in ANIMAL_TO_FOLDERS_MAP.items() if k in ANIMALS}
    ANIMAL_TO_FULL_ID_MAP = {k: v for k, v in ANIMAL_TO_FULL_ID_MAP.items() if k in ANIMALS}
    print(f"[info] truncate_animals={_truncate_animals}: running first {len(ANIMALS)} animal(s): {ANIMALS}")


def get_animal_folders(wildcards):
    """Get the list of (data_folder, animal_id, config_key) tuples for an animal."""
    return ANIMAL_TO_FOLDERS_MAP[wildcards.animal]

def get_animal_folder(wildcards):
    """Get the primary (first) data folder for an animal.
    
    Used for backward compatibility with downstream rules (e.g. log paths).
    """
    return ANIMAL_TO_FOLDERS_MAP[wildcards.animal][0][0]


def get_joint_session_channels(wildcards):
    """Get channel subset for joint session animals, or None for regular animals.

    Uses the new _animal_channel_subsets dict from expand_animals_config().
    """
    animal_id = ANIMAL_TO_FULL_ID_MAP[wildcards.animal]
    return samples_config.get("_animal_channel_subsets", {}).get(animal_id)


def get_animal_id(wildcards):
    """Get the original animal ID string."""
    return ANIMAL_TO_FULL_ID_MAP[wildcards.animal]


# Animals war_quality_filter excluded, with the reason it recorded. Every helper below that
# gathers per-animal outputs from after the quality filter goes through _passed_quality_filter,
# so an excluded animal is reported once in the main log rather than silently missing from the
# results, and the run ends by listing every exclusion (onsuccess and onerror, at the end).
QUALITY_FILTER_EXCLUDED = {}


def _passed_quality_filter(anim):
    """True if war_quality_filter kept this animal; otherwise record and report why it did not."""
    kept, reason = quality_filter_outcome(checkpoints.war_quality_filter.get(animal=anim).output[0])
    if not kept and anim not in QUALITY_FILTER_EXCLUDED:
        QUALITY_FILTER_EXCLUDED[anim] = reason
        logger.warning(f"war_quality_filter excluded {anim}: {reason}. It is absent from every later step.")
    return kept


