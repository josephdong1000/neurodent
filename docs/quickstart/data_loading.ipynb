            "lro_si = core.LongRecordingOrganizer(\n",
            "    base_folder=si_data_path,\n",
            "    animal_id=animal_id,\n",
            "    mode=\"si\",  # SpikeInterface mode\n",
            ")\n",
            "\n",
            "print(f\"Loaded {len(lro_si.recordings)} SpikeInterface recordings\")"
